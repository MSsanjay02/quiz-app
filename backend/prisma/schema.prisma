generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum QuizStatus {
  DRAFT
  PUBLISHED
  LOBBY
  LIVE
  PAUSED
  COMPLETED
}

enum QuestionType {
  MCQ
  TRUE_FALSE
  // Extension point: MULTIPLE_SELECT is intentionally NOT enabled in v1.
}

enum AnswerStatus {
  CORRECT
  WRONG
  NOT_ATTEMPTED
}

model Admin {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  quizzes      Quiz[]
}

model Quiz {
  id                String     @id @default(uuid())
  title             String
  description       String?
  category          String?
  status            QuizStatus @default(DRAFT)
  pin               String?    @unique
  maxParticipants   Int        @default(150)
  shuffleQuestions  Boolean    @default(true)
  shuffleOptions    Boolean    @default(true)
  enableLeaderboard Boolean    @default(true)
  enableAntiCheat   Boolean    @default(true)
  enableFullscreen  Boolean    @default(true)
  currentQuestionIx Int        @default(-1)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  adminId      String
  admin        Admin         @relation(fields: [adminId], references: [id])
  questions    Question[]
  participants Participant[]

  @@index([pin])
  @@index([adminId])
}

model Question {
  id            String       @id @default(uuid())
  quizId        String
  order         Int
  type          QuestionType @default(MCQ)
  question      String
  optionA       String
  optionB       String
  optionC       String?
  optionD       String?
  correctAnswer String
  timerSeconds  Int          @default(20)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  quiz    Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers Answer[]

  @@index([quizId])
}

model Participant {
  id             String   @id @default(uuid())
  quizId         String
  name           String
  score          Int      @default(0)
  warnings       Int      @default(0)
  rank           Int?
  disqualified   Boolean  @default(false)
  connected      Boolean  @default(true)
  lastSeenAt     DateTime @default(now())
  socketId       String?
  currentQIndex  Int      @default(0)
  questionOrder  Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  quiz        Quiz          @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers     Answer[]
  auditEvents AuditEvent[]

  @@unique([quizId, name])
  @@index([quizId])
}

model Answer {
  id            String       @id @default(uuid())
  participantId String
  questionId    String
  answer        String?
  status        AnswerStatus @default(NOT_ATTEMPTED)
  timeTakenMs   Int          @default(0)
  score         Int          @default(0)
  createdAt     DateTime     @default(now())

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  question    Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([participantId, questionId])
  @@index([questionId])
}

enum AuditEventType {
  TAB_SWITCH
  FOCUS_LOSS
  FULLSCREEN_EXIT
  DEVTOOLS_DETECTED
  COPY_ATTEMPT
  RECONNECT
  DISCONNECT
  WARNING_ISSUED
  DISQUALIFIED
}

model AuditEvent {
  id            String         @id @default(uuid())
  participantId String
  type          AuditEventType
  meta          Json?
  createdAt     DateTime       @default(now())

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([participantId])
}
